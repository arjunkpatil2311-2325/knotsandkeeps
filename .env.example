# Supabase Configuration
# Found at: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (NEVER expose to the browser!)
# Used for server-side admin actions (e.g. creating admin notifications)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Configuration (Resend)
# Found at: Resend Dashboard -> API Keys
RESEND_API_KEY=your_resend_api_key

# The email address that Knots & Keeps emails will be sent from
# (Must be a verified domain in Resend, or 'onboarding@resend.dev' for testing)
EMAIL_FROM=orders@knotsandkeeps.com
